{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://se-kb.local/schemas/retrieval-query-v1.schema.json",
  "title": "Retrieval evaluation query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "id", "text", "intent", "relevance", "hard_negatives", "no_answer", "split"],
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "relevance": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}},
    "hard_negatives": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "no_answer": {"type": "boolean"},
    "split": {"enum": ["dev", "holdout"]}
  }
}

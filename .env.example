# Service authentication (comma-separated; replace with long random values)
KB_READ_KEYS=replace-with-read-key
KB_ADMIN_KEYS=replace-with-admin-key

# Exact browser origins, no wildcard
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
API_DEBUG=false

# Input and concurrency defaults
MAX_REQUEST_BYTES=1048576
MAX_QUERY_CHARS=4000
MAX_TOP_K=100
MAX_TASK_LIMIT=50
REQUESTS_PER_MINUTE=120
MAX_REQUEST_CONCURRENCY=16
MAX_RESPONSE_BYTES=4194304
MAX_TOKENS_PER_TASK=100000
MAX_TASK_SECONDS=600
MAX_QUEUE_DEPTH=100
MEMORY_WARNING_BYTES=1073741824
DISK_WARNING_FREE_BYTES=2147483648

# Model/provider settings (network and possible cost; leave keys unset for offline checks)
OPENAI_API_KEY=
BASE_URL=
MODEL=
FILTER_API_KEY=
FILTER_BASE_URL=
FILTER_MODEL_ID=
KB_API_KEY=
KB_BASE_URL=
KB_MODEL_ID=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=

# Runtime paths (defaults resolve under the project root)
# SE_KB_PROJECT_ROOT=
# CONFIG_ROOT=
# DATA_ROOT=
# CACHE_ROOT=
# OUTPUT_ROOT=

# Optional Obsidian Vault projection (disabled while root is unset)
# OBSIDIAN_VAULT_ROOT=C:/Users/example/Documents/My Vault
# OBSIDIAN_VAULT_NAME=My Vault
OBSIDIAN_MANAGED_DIRECTORY=SE-KB
OBSIDIAN_ENTITY_KINDS=concept,rule,pattern,example
OBSIDIAN_SEMANTIC_EDGES=true
OBSIDIAN_SEMANTIC_MIN_SCORE=0.75
OBSIDIAN_SEMANTIC_MAX_NEIGHBORS=5
OBSIDIAN_GRAPH_NODE_LIMIT=500
OBSIDIAN_CANVAS_ENABLED=false

# Remote fetch policy
ALLOW_PRIVATE_NETWORK_FETCH=false
FETCH_MAX_REDIRECTS=5
FETCH_MAX_COMPRESSED_BYTES=8388608
FETCH_MAX_DECOMPRESSED_BYTES=16777216
FETCH_MAX_IMAGE_PIXELS=40000000
FETCH_TOTAL_SECONDS=60
FETCH_CONNECT_SECONDS=10
FETCH_READ_SECONDS=20
FETCH_WRITE_SECONDS=20
FETCH_POOL_SECONDS=5

# Container worker lifecycle (only used by deploy/Dockerfile)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
